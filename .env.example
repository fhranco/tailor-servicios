# ==============================================================================
# TAILOR SERVICIOS - TEMPLATE DE VARIABLES DE ENTORNO
# ==============================================================================
# IMPORTANTE: Nunca expongas valores reales o claves de producción en repositorios
# públicos o privados. Este archivo sirve de referencia para configurar Vercel
# y entornos locales (.env.local).
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (Base de datos & Autenticación)
# ------------------------------------------------------------------------------
# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (con Row Level Security - RLS activo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave Service Role (EXCLUSIVA de backend / servidor; NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Correos de administradores autorizados (separados por coma, ej. administrador@gmail.com).
# Si está vacío y el usuario no tiene claim protegido app_metadata.role = 'admin', el acceso se deniega por defecto.
ADMIN_ALLOWED_EMAILS=

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (Resend API / SMTP)
# ------------------------------------------------------------------------------
# Host SMTP de Resend
SMTP_HOST=smtp.resend.com

# Puerto seguro SMTP
SMTP_PORT=465

# Usuario SMTP (en Resend se utiliza 'resend')
SMTP_USER=resend

# API Key de Resend (inicia con re_...) o contraseña de aplicación
SMTP_PASSWORD=re_tu_api_key_aqui

# Remitente verificado en DNS (debe coincidir con dominio verificado en Resend)
EMAIL_FROM=Tailor Servicios <contacto@tailorservicios.cl>

# Bandeja de destino para alertas de nuevos prospectos B2B y postulaciones
LEADS_NOTIFICATION_EMAIL=contacto@tailorservicios.cl
